{
  "name": "comark-knap",
  "version": "0.0.0",
  "description": "Comark plugin that renders knap templates (variables, filters, if/for logic) before parsing",
  "keywords": [
    "comark",
    "markdown",
    "mdc",
    "plugin",
    "knap",
    "template",
    "obsidian"
  ],
  "homepage": "https://github.com/atinux/comark-knap#readme",
  "bugs": {
    "url": "https://github.com/atinux/comark-knap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atinux/comark-knap.git"
  },
  "author": "Sébastien Chopin <atinux@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "tsx playground/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "play:vue": "pnpm --filter comark-knap-playground-vue dev"
  },
  "peerDependencies": {
    "comark": ">=0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "comark": "^0.7.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "knap": "^0.4.2"
  }
}
